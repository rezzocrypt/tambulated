{
  "manifest_version": 3,
  "name": "Bookmark Manager",
  "version": "1.0",
  "offline_enabled": true,
  "description": "Управление закладками с помощью Vue.js",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "bookmarks",
    "storage"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}